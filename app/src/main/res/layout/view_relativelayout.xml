<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- Fila 1 -->
    <TextView
        android:id="@+id/label_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:text="@string/app_name" />

    <TextView
        android:id="@+id/label_surname1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/label_name"
        android:text="@string/rl_label_surname" />

    <TextView
        android:id="@+id/label_surname2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/label_surname1"
        android:text="@string/rl_label_surname_2" />

    <TextView
        android:id="@+id/label_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        tools:text="20 años" />

    <!-- Fila 2 -->
    <TextView
        android:id="@+id/label_address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/label_name"
        tools:text="Calle XXX" />

    <TextView
        android:id="@+id/label_phonenumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/label_age"
        android:layout_alignParentEnd="true"
        tools:text="+34 600 000 000" />

    <TextView
        android:id="@+id/label_number_address"
        tools:text="Bloque 2"
        android:layout_alignStart="@+id/label_surname2"
        android:layout_below="@id/label_surname2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <RelativeLayout
        android:background="@color/orange"
        android:layout_width="32dp"
        android:layout_height="32dp"/>

</RelativeLayout>